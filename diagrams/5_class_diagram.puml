' ===================== CUSTOM VALUE TYPES (you define these) =====================

' Migration holds the per-migration ROLES (source/target are NOT node properties).
' A location is an open string id: "vehicle_1", "edge_a", "dt_cloud", "vehicle_2"...
class Migration << (D,#F9A825) dataclass >> #FFF9C4 {
