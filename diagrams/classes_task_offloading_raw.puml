@startuml classes_task_offloading_raw
set namespaceSeparator none
class "Decision" as task_offloading.value_types.Decision {
  node_id : str
  reason : str
  should_migrate : bool
  target_location : str
}
class "Migration" as task_offloading.value_types.Migration {
  node_id : str
  source_location : str
  started_at : float
  status : str
  target_location : str
}
class "NodeRecord" as task_offloading.value_types.NodeRecord {
  cpu_usage : float
  current_location : str
  last_heartbeat : float
  lifecycle_state : str
  mem_usage : float
  node_id : str
}
class "NodeStatus" as task_offloading.value_types.NodeStatus {
  cpu_usage : float
  current_location : str
  lifecycle_state : str
  mem_usage : float
  migration_eligible : bool
  node_id : str
}
class "OffloadManager" as task_offloading.offload_manager.OffloadManager {
  {abstract}confirm_completion(migration: Migration) -> None
  {abstract}deregister_node(node_id: str) -> None
  {abstract}evaluate() -> Decision
  {abstract}handle_manual_request(request, response)
  {abstract}initiate_migration(node_id: str, target_location: str) -> Migration
  {abstract}monitor_progress(migration: Migration) -> None
  {abstract}register_node(record: NodeRecord) -> None
  {abstract}rollback(migration: Migration) -> None
  {abstract}spawn_target(location: str) -> OffloadableNode
}
class "OffloadableNode" as task_offloading.offloadable_node.OffloadableNode {
  {abstract}deserialize_state(data: bytes) -> None
  {abstract}get_snapshot() -> StateSnapshot
  {abstract}handle_offload_request(request, response)
  {abstract}on_activate(state: LifecycleState) -> TransitionCallbackReturn
  {abstract}on_configure(state: LifecycleState) -> TransitionCallbackReturn
  {abstract}on_deactivate(state: LifecycleState) -> TransitionCallbackReturn
  {abstract}on_error(state: LifecycleState) -> TransitionCallbackReturn
  {abstract}on_shutdown(state: LifecycleState) -> TransitionCallbackReturn
  {abstract}register_with_manager() -> None
  {abstract}report_location() -> None
  {abstract}report_status() -> NodeStatus
  {abstract}restore_snapshot(snapshot: StateSnapshot) -> None
  {abstract}send_heartbeat() -> None
  {abstract}serialize_state() -> bytes
}
class "Sensor" as task_offloading.sensor.Sensor {
  {abstract}publish() -> None
  {abstract}report_location() -> None
}
class "StateSnapshot" as task_offloading.value_types.StateSnapshot {
  buffered_messages : bytes
  subscriptions : list
  timestamp : float
  variables : bytes
  version : int
  {abstract}from_bytes(data: bytes) -> 'StateSnapshot'
  {abstract}to_bytes() -> bytes
}
@enduml
