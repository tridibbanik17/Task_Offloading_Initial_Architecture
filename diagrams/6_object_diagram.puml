@startuml Object_Diagram
scale 1.5
title Task Offloading Framework - Object Diagram (runtime snapshot during a migration)

skinparam backgroundColor white
skinparam objectAttributeIconSize 0
skinparam defaultFontName Helvetica

' ===================== OBJECTS (instances) =====================
' Convention: name : Class  (these are runtime objects, not classes)

object "manager : OffloadManager" as MGR #BBDEFB {
    cpu_threshold = 0.85
    mem_threshold = 0.80
    latency_threshold = 50 ms
    registry = { perception, lidar, camera_sensor }
    active_migrations = { "perception": mig_1 }
}

object "camera_sensor : Sensor" as SENSOR #FFE0B2 {
    node_id = "camera_sensor"
    sensor_id = "cam_front"
    current_location = "vehicle_1"
}

' The node being migrated - currently on the source location (Physical vehicle)
object "offloadable_node_1 : OffloadableNode" as SRC #FFCC80 {
    node_id = "perception"
    current_location = "vehicle_1"
    lifecycle_state = "active"
    snapshot_version = 7
}

' The freshly spawned instance on the target location (an edge server)
object "offloadable_node_2 : OffloadableNode" as TGT #C8E6C9 {
    node_id = "perception"
    current_location = "edge_server_a"
    lifecycle_state = "configuring"
    snapshot_version = 7
}

' A second, unrelated offloadable node still running normally on the vehicle
object "offloadable_node_3 : OffloadableNode" as OTHER #FFCC80 {
    node_id = "lidar"
    current_location = "vehicle_1"
    lifecycle_state = "active"
    snapshot_version = 3
}

' The Migration object holds the per-migration ROLES (source/target)
object "mig_1 : Migration" as MIG #FFF9C4 {
    node_id = "perception"
    source_location = "vehicle_1"
    target_location = "edge_server_a"
    status = "in_progress"
    started_at = 1724873400.05
}

' The snapshot object produced by the source and consumed by the target
object "snapshot_7 : StateSnapshot" as SNAP #FFF9C4 {
    version = 7
    variables = <bytes>
    buffered_messages = <bytes>
    subscriptions = [ "/sensor/data" ]
    timestamp = 1724873400.12
}

' ===================== LINKS (object references at this instant) =====================

' Manager holds references to the nodes it manages
MGR --> SRC   : manages
MGR --> TGT   : manages (spawned)
MGR --> OTHER : manages

' Manager tracks this migration; the Migration names the source/target roles
MGR --> MIG   : tracks
MIG ..> SRC   : source_location
MIG ..> TGT   : target_location

' Source produced the snapshot; target is restoring from it
SRC --> SNAP  : produced
SNAP --> TGT  : restored into

' Sensor feeds the perception node over the topic (source now, target after cutover)
SENSOR ..> SRC : /sensor/data

note bottom of MIG
  offloadable_node_1 and offloadable_node_2 are TWO OBJECTS
  of the SAME class (OffloadableNode) with the same node_id
  "perception". Neither stores "source"/"target" - those roles
  live only in mig_1. Next time the roles could be reversed.
end note

note top of SENSOR
  In code (rclpy):
  - Sensor extends rclpy.node.Node
  - OffloadableNode extends rclpy.lifecycle.LifecycleNode
  lifecycle_state values are ROS2 lifecycle states:
  unconfigured / inactive / active / finalized
  (plus transition states, e.g. configuring).
  current_location is an open id (vehicle / edge / cloud / other DT).
end note

@enduml
